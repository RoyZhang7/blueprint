// Gordion Phase K1 variant full_wakeup of probe v5 (generated by k1/variants.py; block logic unchanged, see its docstring)
tracepoint:sched:sched_wakeup,
tracepoint:sched:sched_wakeup_new
{
  $ts = @sleep[args->pid];
  if ($ts != 0) {
    $d = nsecs - $ts;
    $wk = 3;
    if (pid == 0) { $wk = 4; }
    else if (cgroup == (uint64)__SVCID__) { $wk = 0; }
    else if (cgroup == (uint64)__AGGRID__) { $wk = 1; }
    else if (cgroup == (uint64)__ROOTID__) { $wk = 2; }
    if (@sleepfutex[args->pid] != 0) { @Qlock += $d; @Qlockn += 1; @Wf[$wk] += $d; @Wfn[$wk] += 1; delete(@sleepfutex[args->pid]); }
    else { @Qidle += $d; @Qidlen += 1; @Wo[$wk] += $d; @Won[$wk] += 1; }
    delete(@sleep[args->pid]);
    $c = args->target_cpu; $now = nsecs;
    $el = @lastsw[$c] != 0 ? $now - @lastsw[$c] : 0;
    @runnable[args->pid] = $now; @rcpu[args->pid] = $c + 1;
    @snap1[args->pid] = @occ1[$c] + (@curcls[$c] == 1 ? $el : 0);
    @snap2[args->pid] = @occ2[$c] + (@curcls[$c] == 2 ? $el : 0);
    @snap3[args->pid] = @occ3[$c] + (@curcls[$c] == 3 ? $el : 0);
  }
}

tracepoint:sched:sched_process_exit
{
  $x = args->pid;
  delete(@cg[$x]); delete(@runnable[$x]); delete(@rcpu[$x]); delete(@snap1[$x]); delete(@snap2[$x]); delete(@snap3[$x]);
  delete(@sleep[$x]); delete(@sleepfutex[$x]); delete(@infutex[$x]);
}

interval:ms:100
{
  @wseq += 1;
  printf("{\"q\":%llu,\"ns\":%llu,\"preempt\":%llu,\"multi\":%llu,\"mig\":%llu}\n",
         @wseq, nsecs, @preempt, @multi, @mig);
  printf("{\"q2\":%llu,\"Qlock\":%llu,\"Qlockn\":%llu,\"Qidle\":%llu,\"Qidlen\":%llu,\"Wf0\":%llu,\"Wf1\":%llu,\"Wf2\":%llu,\"Wf3\":%llu,\"Wf4\":%llu,\"Wo0\":%llu,\"Wo1\":%llu,\"Wo2\":%llu,\"Wo3\":%llu,\"Wo4\":%llu,\"Wfn0\":%llu,\"Wfn4\":%llu,\"Won0\":%llu,\"Won4\":%llu}\n",
         @wseq, @Qlock, @Qlockn, @Qidle, @Qidlen, @Wf[0], @Wf[1], @Wf[2], @Wf[3], @Wf[4], @Wo[0], @Wo[1], @Wo[2], @Wo[3], @Wo[4], @Wfn[0], @Wfn[4], @Won[0], @Won[4]);
  zero(@Wf); zero(@Wo); zero(@Wfn); zero(@Won); @Qlock = 0; @Qlockn = 0; @Qidle = 0; @Qidlen = 0; @preempt = 0; @multi = 0; @mig = 0;
  if (@wseq == 0) { @Rhist = 0; }
  if (@wseq == 0) { @Rthr = 0; }
  if (@wseq == 0) { @cg[0] = 0; }
  if (@wseq == 0) { @curcls[0] = 0; }
  if (@wseq == 0) { @infutex[0] = 0; }
  if (@wseq == 0) { @lastsw[0] = 0; }
  if (@wseq == 0) { @occ1[0] = 0; }
  if (@wseq == 0) { @occ2[0] = 0; }
  if (@wseq == 0) { @occ3[0] = 0; }
  if (@wseq == 0) { @sleep[0] = 0; }
  if (@wseq == 0) { @sleepfutex[0] = 0; }
}

interval:s:1
{
  print(@Rhist); zero(@Rhist);
  print(@Rthr); zero(@Rthr);
}
