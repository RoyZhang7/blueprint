// Gordion Phase G probe v5 (Addendum F; v4 + (F.1) one record per resume of a service thread with its run-queue delay split
// by holder, (F.2) softirq time per vector on the cpuset and the raise-to-wake-up delay of the softirqs that wake service
// threads, credited to the task that was running when the softirq was raised). v4 (Addendum E.3): occupancy of the cpuset's
// SMT SIBLINGS by holder class, the waker split of the service threads' sleeps, idle charged to its own class.
// (PHASEG-HANDOFF.md section 2.2, Addenda E and F.) Run-queue delay of the service's threads split by the cgroups that
// held the CPU while the thread waited, credited BY TIME SHARE (per-CPU occupancy counters per holder class, snapshotted
// when the thread becomes runnable); the last-holder credit of v1 is kept beside it (L*) for comparison. Sleep time split
// by futex (lock) vs other, per CPU of the service's cpuset.
// Template: probe.py substitutes __CPUFILTER__ (cpu == 1 || cpu == 3 ...), __SIBFILTER__ (the SMT siblings of the cpuset,
// or cpu == -1 when none), __SVCID__, __AGGRID__, __ROOTID__ (cgroup v2 ids = inode numbers of the cgroup directories).
// Hooks that need no BTF (bpftrace 0.14 + libbpf 0.5 cannot read the 6.12 kernel's BTF): tracepoint:sched:sched_switch
// runs with current == prev, so prev's cgroup is the `cgroup` builtin and prev_state an argument; next's cgroup comes
// from a pid -> cgroup map learned whenever a task is switched out. Holder classes: 0 = the service's own cgroup
// (R_self), 1 = the aggressor cgroup (R_foreign), 2 = the root cgroup (kernel threads, un-sliced host processes),
// 3 = any other cgroup (R_other, reported, never attributed; a not-yet-known task counts here too), 4 (v4) = the idle
// task (pid 0; before v4 idle time was inside class 2's occupancy, so Oroot of v3 = Oroot + Oidle of v4).
// prev_state: the low byte is 0 for a runnable (preempted) task, non-zero for every sleeping state.
// A thread that resumes on a CPU other than the one it was marked runnable on gets the last-holder credit (@mig counts).
// no BEGIN/END probes: bpftrace 0.14's BEGIN trigger does not resolve on the stripped Ubuntu binary.
// v5 records (probe.py routes them to <out>-resume.jsonl): {"r":tid,"ns":..,"d":gap,"a":aggr,"s":self,"o":root+other,"c":cpu}
// per resume with the time-share split (ns), or {"r":tid,"ns":..,"d":gap,"h":holder,"m":1} when the thread resumed on
// another CPU (last-holder credit); {"k":tid,"ns":..,"v":vec,"dl":raise-to-wakeup ns,"cl":class running at the raise}
// per wake-up of a service thread that happened inside a softirq on the cpuset.

tracepoint:sched:sched_switch /__CPUFILTER__/
{
  $now = nsecs;
  $pp = args->prev_pid; $np = args->next_pid;
  $pcg = cgroup;                                  // current == prev here
  // (0) occupancy of this CPU since the previous switch, charged to prev's class (v4: idle = class 4, not root)
  if (@lastsw[cpu] != 0) {
    $dt = $now - @lastsw[cpu];
    if ($pp == 0) { @occw[4] += $dt; }
    else if ($pcg == (uint64)__SVCID__) { @occ0[cpu] += $dt; @occw[0] += $dt; }
    else if ($pcg == (uint64)__AGGRID__) { @occ1[cpu] += $dt; @occw[1] += $dt; }
    else if ($pcg == (uint64)__ROOTID__) { @occ2[cpu] += $dt; @occw[2] += $dt; }
    else { @occ3[cpu] += $dt; @occw[3] += $dt; }
  }
  @lastsw[cpu] = $now;
  @cg[$pp] = $pcg;
  $ncg = @cg[$np];
  // (1) a service thread resumes: split its runnable gap by the holders' time share on this CPU
  if ($ncg == (uint64)__SVCID__) {
    $tr = @runnable[$np];
    if ($tr != 0) {
      $d = $now - $tr;
      $h = @holder[cpu];
      if (@rcpu[$np] == cpu + 1) {
        $a = (int64)(@occ1[cpu] - @snap1[$np]); $r = (int64)(@occ2[cpu] - @snap2[$np]); $o = (int64)(@occ3[cpu] - @snap3[$np]);
        if ($a < 0) { $a = 0; } if ($r < 0) { $r = 0; } if ($o < 0) { $o = 0; }
        $s = (int64)($d) - $a - $r - $o; if ($s < 0) { $s = 0; }
        $su = (uint64)($s); $au = (uint64)($a); $ru = (uint64)($r); $ou = (uint64)($o);
        @R[0] += $su; @R[1] += $au; @R[2] += $ru; @R[3] += $ou;
        printf("{\"r\":%d,\"ns\":%llu,\"d\":%llu,\"a\":%llu,\"s\":%llu,\"o\":%llu,\"c\":%d,\"w\":%d}\n", $np, $now, $d, $au, $su, $ru + $ou, cpu, @wk[$np]);
      } else {
        @R[$h] += $d; @mig += 1;
        printf("{\"r\":%d,\"ns\":%llu,\"d\":%llu,\"h\":%d,\"m\":1,\"w\":%d}\n", $np, $now, $d, $h, @wk[$np]);
      }
      @RL[$h] += $d; @Rn[$h] += 1;
      @Rthr[$np] += $d;
      @Rhist = hist($d);
      if (@nholders[cpu] > 1) { @multi += 1; }
      delete(@runnable[$np]); delete(@rcpu[$np]);
    }
    @holder[cpu] = 0; @nholders[cpu] = 0; @curcls[cpu] = 0;
  } else {
    if ($ncg == (uint64)__AGGRID__) { @holder[cpu] = 1; @curcls[cpu] = 1; }
    else if ($ncg == (uint64)__ROOTID__) { @holder[cpu] = 2; @curcls[cpu] = 2; }
    else { @holder[cpu] = 3; @curcls[cpu] = 3; }
    @nholders[cpu] += 1;
  }
  // (2) a service thread leaves the CPU: preempted (still runnable) or asleep
  if ($pcg == (uint64)__SVCID__) {
    if ((args->prev_state & 0xff) == 0) {
      @runnable[$pp] = $now; @rcpu[$pp] = cpu + 1; @snap1[$pp] = @occ1[cpu]; @snap2[$pp] = @occ2[cpu]; @snap3[$pp] = @occ3[cpu]; @preempt += 1; @wk[$pp] = 0;
    } else {
      @sleep[$pp] = $now; if (@infutex[$pp] != 0) { @sleepfutex[$pp] = 1; }
    }
  }
}

// v4 (a): occupancy of the cpuset's SMT siblings by holder class, per window (phi_sibling = Osib[1] / (k x window)).
tracepoint:sched:sched_switch /__SIBFILTER__/
{
  $now = nsecs; $pcg = cgroup;
  if (@lastsws[cpu] != 0) {
    $dt = $now - @lastsws[cpu];
    if (args->prev_pid == 0) { @occs[4] += $dt; }
    else if ($pcg == (uint64)__SVCID__) { @occs[0] += $dt; }
    else if ($pcg == (uint64)__AGGRID__) { @occs[1] += $dt; }
    else if ($pcg == (uint64)__ROOTID__) { @occs[2] += $dt; }
    else { @occs[3] += $dt; }
  }
  @lastsws[cpu] = $now;
}

// v5 (F.2): softirqs on the cpuset. raise -> entry latency per vector (@SL) and by the class of the task that was running
// at the raise (@SLc); time in softirq per vector (@ST, count @STn); @sev[cpu] = vec + 1 while a softirq runs on the CPU.
tracepoint:irq:softirq_raise /__CPUFILTER__/
{
  $v = args->vec; @sr[cpu, $v] = nsecs; @srl[cpu, $v] = nsecs;
  $cls = 3;
  if (pid == 0) { $cls = 4; }
  else if (cgroup == (uint64)__SVCID__) { $cls = 0; }
  else if (cgroup == (uint64)__AGGRID__) { $cls = 1; }
  else if (cgroup == (uint64)__ROOTID__) { $cls = 2; }
  @srcls[cpu, $v] = $cls;
}
tracepoint:irq:softirq_entry /__CPUFILTER__/
{
  $v = args->vec; @se[cpu] = nsecs; @sev[cpu] = $v + 1;
  $r = @sr[cpu, $v];
  if ($r != 0) { $lat = nsecs - $r; @SL[$v] += $lat; @SLc[@srcls[cpu, $v]] += $lat; @SLn[$v] += 1; delete(@sr[cpu, $v]); }
}
tracepoint:irq:softirq_exit /__CPUFILTER__/
{
  $v = args->vec;
  if (@se[cpu] != 0) { $dt = nsecs - @se[cpu]; @ST[$v] += $dt; @STn[$v] += 1; }
  @se[cpu] = 0; @sev[cpu] = 0;
}

// v4 (b): the sleep that just ended, classified by the WAKER (the task running sched_wakeup): 0 = our own cgroup, 1 = the
// aggressor cgroup, 2 = the root cgroup, 3 = another cgroup, 4 = the idle task (pid 0: an interrupt or softirq on an idle
// CPU). Crossed with the futex flag of the sleep: Wf[c] / Wo[c] ns. v5 (F.2): when the wake-up happens inside a softirq
// on the cpuset, the delay from that softirq's raise to this wake-up is credited to the class that was running at the
// raise (@WS[cls], @WSn[cls]) and emitted per wake-up as a "k" record.
tracepoint:sched:sched_wakeup
{
  $ts = @sleep[args->pid];
  if ($ts != 0) {
    $d = nsecs - $ts;
    $wk = 3;
    if (pid == 0) { $wk = 4; }
    else if (cgroup == (uint64)__SVCID__) { $wk = 0; }
    else if (cgroup == (uint64)__AGGRID__) { $wk = 1; }
    else if (cgroup == (uint64)__ROOTID__) { $wk = 2; }
    if (@sleepfutex[args->pid] != 0) { @Qlock += $d; @Qlockn += 1; @Wf[$wk] += $d; @Wfn[$wk] += 1; delete(@sleepfutex[args->pid]); }
    else { @Qidle += $d; @Qidlen += 1; @Wo[$wk] += $d; @Won[$wk] += 1; }
    delete(@sleep[args->pid]);
    if (@sev[cpu] != 0) {
      $v = @sev[cpu] - 1; $rl = @srl[cpu, $v];
      if ($rl != 0) { $dl = nsecs - $rl; $cl = @srcls[cpu, $v]; @WS[$cl] += $dl; @WSn[$cl] += 1;
        printf("{\"k\":%d,\"ns\":%llu,\"v\":%d,\"dl\":%llu,\"cl\":%d}\n", args->pid, nsecs, $v, $dl, $cl); }
    }
    $c = args->target_cpu; $now = nsecs;
    $el = @lastsw[$c] != 0 ? $now - @lastsw[$c] : 0;
    @runnable[args->pid] = $now; @rcpu[args->pid] = $c + 1; @wk[args->pid] = 1;
    @snap1[args->pid] = @occ1[$c] + (@curcls[$c] == 1 ? $el : 0);
    @snap2[args->pid] = @occ2[$c] + (@curcls[$c] == 2 ? $el : 0);
    @snap3[args->pid] = @occ3[$c] + (@curcls[$c] == 3 ? $el : 0);
  }
}

// v3.2: a thread exits -> drop its per-thread entries (thread-per-connection servers fill the maps otherwise). Not @Rthr
// (zero()ed and print()ed from userspace every second; bpftrace 0.14 aborts when a key vanishes under that pass).
tracepoint:sched:sched_process_exit
{
  $x = args->pid;
  delete(@cg[$x]); delete(@runnable[$x]); delete(@rcpu[$x]); delete(@snap1[$x]); delete(@snap2[$x]); delete(@snap3[$x]);
  delete(@sleep[$x]); delete(@sleepfutex[$x]); delete(@infutex[$x]); delete(@wk[$x]);
}

tracepoint:syscalls:sys_enter_futex /cgroup == (uint64)__SVCID__/ { @infutex[tid] = 1; }
tracepoint:syscalls:sys_exit_futex  /cgroup == (uint64)__SVCID__/ { delete(@infutex[tid]); }

interval:ms:100
{
  @wseq += 1;
  printf("{\"q\":%llu,\"ns\":%llu,\"Rself\":%llu,\"Raggr\":%llu,\"Rroot\":%llu,\"Rother\":%llu,\"Lself\":%llu,\"Laggr\":%llu,\"Lroot\":%llu,\"Lother\":%llu,\"nself\":%llu,\"naggr\":%llu,\"nroot\":%llu,\"nother\":%llu,\"Qlock\":%llu,\"Qlockn\":%llu,\"Qidle\":%llu,\"Qidlen\":%llu,\"preempt\":%llu,\"multi\":%llu,\"mig\":%llu,\"Oself\":%llu,\"Oaggr\":%llu,\"Oroot\":%llu,\"Oother\":%llu,\"Oidle\":%llu,\"Sself\":%llu,\"Saggr\":%llu,\"Sroot\":%llu,\"Sother\":%llu,\"Sidle\":%llu}\n",
         @wseq, nsecs, @R[0], @R[1], @R[2], @R[3], @RL[0], @RL[1], @RL[2], @RL[3], @Rn[0], @Rn[1], @Rn[2], @Rn[3], @Qlock, @Qlockn, @Qidle, @Qidlen, @preempt, @multi, @mig, @occw[0], @occw[1], @occw[2], @occw[3], @occw[4],
         @occs[0], @occs[1], @occs[2], @occs[3], @occs[4]);
  // second half of the same window (probe.py merges the two records by q): the waker split (v4 b) and the softirq fields (v5)
  printf("{\"q2\":%llu,\"Wf0\":%llu,\"Wf1\":%llu,\"Wf2\":%llu,\"Wf3\":%llu,\"Wf4\":%llu,\"Wo0\":%llu,\"Wo1\":%llu,\"Wo2\":%llu,\"Wo3\":%llu,\"Wo4\":%llu,\"Wfn0\":%llu,\"Wfn4\":%llu,\"Won0\":%llu,\"Won4\":%llu,\"ST1\":%llu,\"ST2\":%llu,\"ST3\":%llu,\"ST7\":%llu,\"ST9\":%llu,\"STo\":%llu,\"STn3\":%llu,\"SL3\":%llu,\"SLn3\":%llu,\"SLc0\":%llu,\"SLc1\":%llu,\"SLc2\":%llu,\"SLc3\":%llu,\"SLc4\":%llu,\"WS0\":%llu,\"WS1\":%llu,\"WS2\":%llu,\"WS3\":%llu,\"WS4\":%llu,\"WSn0\":%llu,\"WSn1\":%llu,\"WSn2\":%llu,\"WSn3\":%llu,\"WSn4\":%llu}\n",
         @wseq, @Wf[0], @Wf[1], @Wf[2], @Wf[3], @Wf[4], @Wo[0], @Wo[1], @Wo[2], @Wo[3], @Wo[4], @Wfn[0], @Wfn[4], @Won[0], @Won[4],
         @ST[1], @ST[2], @ST[3], @ST[7], @ST[9], @ST[0] + @ST[4] + @ST[5] + @ST[6] + @ST[8], @STn[3], @SL[3], @SLn[3], @SLc[0], @SLc[1], @SLc[2], @SLc[3], @SLc[4], @WS[0], @WS[1], @WS[2], @WS[3], @WS[4], @WSn[0], @WSn[1], @WSn[2], @WSn[3], @WSn[4]);
  zero(@R); zero(@RL); zero(@Rn); zero(@occw); zero(@occs); zero(@Wf); zero(@Wo); zero(@Wfn); zero(@Won); zero(@ST); zero(@STn); zero(@SL); zero(@SLn); zero(@SLc); zero(@WS); zero(@WSn); @Qlock = 0; @Qlockn = 0; @Qidle = 0; @Qidlen = 0; @preempt = 0; @multi = 0; @mig = 0;   // zero(), not clear(): clear() deletes keys and races with the program (bpftrace 0.14 aborts with 'Could not clear map')
}

interval:s:1
{
  print(@Rhist); zero(@Rhist);
  print(@Rthr); zero(@Rthr);
}
